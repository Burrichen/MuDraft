{
  "name": "mudraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:native": "tauri build --no-bundle",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:web": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "npm run check:web && npm run check:rust",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "check:isolation": "cd src-tauri && ! cargo tree -e normal -i tauri-plugin-wdio-webdriver >/dev/null 2>&1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
