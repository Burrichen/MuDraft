{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuDraft",
  "version": "1.0.0",
  "identifier": "app.mudraft.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MuDraft",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: artwork: http://artwork.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "publisher": "MuDraft",
    "copyright": "Copyright © 2026 MuDraft contributors",
    "category": "Music",
    "shortDescription": "Local-first music backlog, album picker, and collection",
    "longDescription": "MuDraft keeps your Listen List, picks one album to hear next, and records listens, ratings, and reviews on your own computer. No account or server.",
    "homepage": "https://github.com/Burrichen/MuDraft"
  }
}
