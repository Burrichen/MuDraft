{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-updates",
  "description": "Desktop only: signed in-app updates (check, download, install, restart). The updater has no Android support.",
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
